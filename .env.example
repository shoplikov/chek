OPENAI_API_KEY=          # required (LLM provider; see docs/DECISIONS.md)
OPENAI_BASE_URL=         # optional: any OpenAI-compatible endpoint (e.g. self-hosted vLLM)
LLM_MODEL=               # optional: one model for both calls (defaults in lib/llm.ts)
LLM_PARSE_MODEL=         # optional: model that reads the photo (default gpt-5.5)
LLM_MATCH_MODEL=         # optional: model that picks the product (default gpt-5.4-mini)
PARSE_EFFORT=            # optional: minimal|low|medium (default low)
MATCH_EFFORT=            # optional: minimal|low|medium (default low)
STRIPE_SECRET_KEY=       # optional, sk_test_ only; without it the demo checkout is used
APP_URL=                 # public base URL, used for Stripe return URLs
