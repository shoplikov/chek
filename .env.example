OPENAI_API_KEY=          # required (LLM provider; see docs/DECISIONS.md)
OPENAI_BASE_URL=         # optional: any OpenAI-compatible endpoint (e.g. self-hosted vLLM)
LLM_MODEL=               # optional: defaults to the model in lib/llm.ts
STRIPE_SECRET_KEY=       # optional, sk_test_ only; without it the demo checkout is used
APP_URL=                 # public base URL, used for Stripe return URLs
